{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "Generates build/vs2022/SkeinDownloader.sln. Release builds go to dist/, Debug builds to dist/debug/.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    }
  ],
  "buildPresets": [
    {"name": "vs2022-release", "displayName": "Release", "configurePreset": "vs2022", "configuration": "Release"},
    {"name": "vs2022-debug", "displayName": "Debug", "configurePreset": "vs2022", "configuration": "Debug"}
  ]
}
