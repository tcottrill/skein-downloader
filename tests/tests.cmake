enable_testing()
add_executable(localization_tests tests/localization.cpp)
target_include_directories(localization_tests PRIVATE src)
target_link_libraries(localization_tests PRIVATE ui_translations)
add_test(NAME localization COMMAND localization_tests)
add_executable(folder_tests tests/folders.cpp)
target_link_libraries(folder_tests PRIVATE archive_core)
add_test(NAME folders COMMAND folder_tests)
add_executable(core_tests tests/core.cpp)
target_link_libraries(core_tests PRIVATE archive_core)
add_test(NAME core COMMAND core_tests)
add_executable(logic_tests tests/logic.cpp)
target_include_directories(logic_tests PRIVATE src/wx)
target_link_libraries(logic_tests PRIVATE ui_logic)
add_test(NAME logic COMMAND logic_tests)
add_executable(download_queue_tests tests/download_queue.cpp)
target_link_libraries(download_queue_tests PRIVATE download_queue)
add_test(NAME download_queue COMMAND download_queue_tests)
add_executable(engine_tests tests/engine.cpp)
target_link_libraries(engine_tests PRIVATE archive_core)
add_executable(staging_tests tests/staging.cpp)
target_link_libraries(staging_tests PRIVATE archive_core)
add_test(NAME staging COMMAND staging_tests)
skein_warnings(localization_tests folder_tests core_tests logic_tests download_queue_tests engine_tests staging_tests)
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_FOUND)
  add_test(NAME engine COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_engine_tests.py" $<TARGET_FILE:engine_tests>)
  add_test(NAME translation_compiler COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/test_translations.py")
  add_test(NAME translation_catalogs COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/translations.py" --check)
endif()
