enable_testing()
add_executable(localization_tests tests/localization.cpp)
target_include_directories(localization_tests PRIVATE src)
target_link_libraries(localization_tests PRIVATE ui_translations)
if(MSVC)
  target_compile_options(localization_tests PRIVATE /utf-8)
endif()
add_test(NAME localization COMMAND localization_tests)
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_FOUND)
  add_test(NAME translation_compiler COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/test_translations.py")
  add_test(NAME translation_catalogs COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/translations.py" --check)
endif()
