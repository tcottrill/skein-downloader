msgstr "+ 動画"

msgid "About"
msgstr "このアプリについて"

msgid "Active"
msgstr "実行中"

msgid "Add to downloads"
msgstr "ダウンロードに追加"

#, c-format
msgid "Added %zu downloads. Existing files and duplicate queue entries were kept."
msgstr "%zu 件のダウンロードを追加しました。既存のファイルと重複するキュー項目は保持されました。"

msgid "Added to downloads."
msgstr "ダウンロードに追加しました。"

msgid "All"
msgstr "すべて"

msgid "All paused  ·  "
msgstr "すべて一時停止  ·  "

msgid "Already in downloads. Resume it from the main window."
msgstr "すでにダウンロードにあります。メイン画面から再開してください。"

msgid "An open-source download manager for files and video.\nStill a work in progress."
msgstr "ファイルと動画用のオープンソースダウンロードマネージャー。\n現在開発中です。"

msgid "Assembling"
msgstr "結合中"

msgid "Audio only"
msgstr "音声のみ"

msgid "Automatic (fastest sample)"
msgstr "自動（測定で最速）"

msgid "Best available"
msgstr "利用可能な最高品質"

msgid "Best available audio, kept in its original audio format.\nChoose MP3 for a widely compatible audio file."
msgstr "利用可能な最高品質の音声を元の形式で保存します。\n幅広い互換性が必要な場合は MP3 を選んでください。"

msgid "Best available audio, saved as MP3 using the highest VBR quality setting.\nConversion cannot improve the source audio quality."
msgstr "利用可能な最高品質の音声を、最高 VBR 品質の MP3 で保存します。\n変換で元の音質を向上させることはできません。"

msgid "Browse…"
msgstr "参照…"

msgid "Cannot add files"
msgstr "ファイルを追加できません"

msgid "Cannot locate Windows PowerShell."
msgstr "Windows PowerShell が見つかりません。"

msgid "Check highlighted"
msgstr "選択項目にチェック"

msgid "Checking for a yt-dlp update…"
msgstr "yt-dlp の更新を確認中…"

msgid "Checking mirror speeds (HTTPS)"
msgstr "ミラーの速度を確認中（HTTPS）"

msgid "Choose a non-empty file with a known size to test speeds."
msgstr "速度テストにはサイズが分かっている空でないファイルを選んでください。"

msgid "Choose an absolute download folder."
msgstr "ダウンロード先は絶対パスで指定してください。"

msgid "Clear History"
msgstr "履歴を消去"

msgid "Clear selection"
msgstr "選択を解除"

msgid "Close"
msgstr "閉じる"

msgid "Complete"
msgstr "完了"

msgid "Connecting"
msgstr "接続中"

msgid "Connections per file"
msgstr "ファイルごとの接続数"

msgid "Cookies give this site your browser's sign-in for it. Use only with sites you trust. Firefox works best: Chrome and Edge on Windows often block other apps from reading their cookies. Close the browser before downloading."
msgstr "Cookie を使うと、サイトにブラウザーのログイン状態が渡されます。信頼できるサイトでのみ使用してください。Firefox を推奨します。Windows の Chrome と Edge は他のアプリによる Cookie の読み取りを制限することがあります。ダウンロード前にブラウザーを閉じてください。"

msgid "Cookies give this site your browser's sign-in for it. Use only with sites you trust. The Flatpak cannot see browser profiles until you allow it read access to them, for example ~/.mozilla with Flatseal."
msgstr "Cookie を使うと、サイトにブラウザーのログイン状態が渡されます。信頼できるサイトでのみ使用してください。Flatpak からブラウザープロファイルを読むには、Flatseal などで ~/.mozilla への読み取りを許可してください。"

#, c-format
msgid "Could not start video tools: %s"
msgstr "動画ツールを起動できませんでした: %s"

msgid "Dark"
msgstr "ダーク"

msgid "Download Again"
msgstr "再ダウンロード"

msgid "Download folder"
msgstr "ダウンロード先フォルダー"

msgid "Downloading"
msgstr "ダウンロード中"

msgid "Failed"
msgstr "失敗"

msgid "File"
msgstr "ファイル"

msgid "File downloads"
msgstr "ファイルのダウンロード"

msgid "Filter by filename…"
msgstr "ファイル名で絞り込み…"

msgid "Finalizing"
msgstr "最終処理中"

msgid "Finished"
msgstr "完了"

msgid "History"
msgstr "履歴"

msgid "Install / repair tools"
msgstr "ツールをインストール / 修復"

msgid "Install the video tools first."
msgstr "先に動画ツールをインストールしてください。"

msgid "Install video tools from Add > Video first."
msgstr "先に「追加 > 動画」から動画ツールをインストールしてください。"

msgid "Install video tools once to enable downloads (about 250 MiB). No admin access needed."
msgstr "動画ツールを一度インストールするとダウンロードできます（約 250 MiB）。管理者権限は不要です。"

msgid "Installing verified video tools…"
msgstr "検証済みの動画ツールをインストール中…"

msgid "Invalid file selection."
msgstr "ファイルの選択が無効です。"

msgid "Language"
msgstr "言語"

msgid "Lets yt-dlp read this site's cookies from your browser, for age checks or other gates. It acts with your browser's sign-in."
msgstr "年齢確認などの制限のために、yt-dlp がブラウザーからサイトの Cookie を読み取れるようにします。ブラウザーのログイン状態で動作します。"

msgid "Light"
msgstr "ライト"

msgid "Load"
msgstr "読み込む"

msgid "Load files"
msgstr "ファイルを読み込む"

msgid "Loading files…"
msgstr "ファイルを読み込み中…"

msgid "MKV (original formats)"
msgstr "MKV（元の形式）"

msgid "MKV: best available source codecs. Your resolution limit still applies.\nSeparate video and audio are merged; a combined source may keep its original container."
msgstr "MKV: 利用可能な最高品質の元コーデック。解像度の上限は適用されます。\n個別の動画と音声は結合されます。一体型のソースは元のコンテナーを保持する場合があります。"

msgid "MP4 (iPhone compatible)"
msgstr "MP4（iPhone 対応）"

msgid "MP4: H.264 video + AAC audio for iPhone playback. No incompatible codec fallback.\nYour resolution limit still applies; unavailable compatible streams will report an error."
msgstr "MP4: iPhone 再生用の H.264 動画 + AAC 音声。非対応コーデックへの代替は行いません。\n解像度の上限は適用されます。対応ストリームがない場合はエラーになります。"

msgid "Name"
msgstr "名前"

msgid "Open folder"
msgstr "フォルダーを開く"

msgid "Operation cancelled. You can retry."
msgstr "操作をキャンセルしました。再試行できます。"

msgid "Partial download retained"
msgstr "途中までのダウンロードを保持しました"

msgid "Paste a URL above. Select one, all, or specific files before adding downloads."
msgstr "上に URL を貼り付けてください。ダウンロードに追加する前に、必要なファイルを選択してください。"

msgid "Paste a YouTube or other supported video URL"
msgstr "YouTube など対応サイトの動画 URL を貼り付け"

msgid "Paste a file, release, package, MediaFire, Google Drive, OneDrive, WeTransfer or archive.org link, or an archive.org item identifier"
msgstr "ファイル、リリース、パッケージ、MediaFire、Google Drive、OneDrive、WeTransfer、archive.org のリンク、または archive.org の項目 ID を貼り付け"

msgid "Paste a file, release, package, MediaFire, Google Drive, OneDrive, WeTransfer, archive.org or video link"
msgstr "ファイル、リリース、パッケージ、MediaFire、Google Drive、OneDrive、WeTransfer、archive.org、動画のリンクを貼り付け"

msgid "Paste a link, choose a quality, then add it to downloads."
msgstr "リンクを貼り付け、品質を選んでダウンロードに追加してください。"

msgid "Paste a valid HTTP or HTTPS file, archive.org or video URL."
msgstr "有効な HTTP または HTTPS のファイル、archive.org、動画の URL を貼り付けてください。"

msgid "Paste a valid HTTP or HTTPS video URL."
msgstr "有効な HTTP または HTTPS の動画 URL を貼り付けてください。"

