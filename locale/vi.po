msgstr "Đã có trong danh sách tải. Hãy tiếp tục từ cửa sổ chính."

msgid "An open-source download manager for files and video.\nStill a work in progress."
msgstr "Trình quản lý tải tệp và video mã nguồn mở.\nVẫn đang được phát triển."

msgid "Assembling"
msgstr "Đang ghép"

msgid "Audio only"
msgstr "Chỉ âm thanh"

