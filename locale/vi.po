msgstr "Đánh dấu các mục được chọn"

msgid "Checking for a yt-dlp update…"
msgstr "Đang kiểm tra bản cập nhật yt-dlp…"

msgid "Checking mirror speeds (HTTPS)"
msgstr "Đang kiểm tra tốc độ máy chủ dự phòng (HTTPS)"

msgid "Choose a non-empty file with a known size to test speeds."
msgstr "Chọn một tệp không rỗng có kích thước đã biết để kiểm tra tốc độ."

msgid "Choose an absolute download folder."
msgstr "Chọn thư mục tải xuống bằng đường dẫn tuyệt đối."

